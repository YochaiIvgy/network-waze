# Postgres 14+. Local: `docker compose up -d` then use the URL below.
DATABASE_URL=postgres://waze:waze@localhost:5433/network_waze

# Required for ingestion / extraction / NL search. Browsing seeded data works without it.
ANTHROPIC_API_KEY=

# Extraction + reasoning model.
WAZE_MODEL=claude-opus-5

# Embeddings. "hash" needs no key and is fine for local demos; "voyage" is the real one.
WAZE_EMBEDDING_PROVIDER=hash
VOYAGE_API_KEY=
