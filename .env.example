# Postgres 14+. Local: `docker compose up -d` then use the URL below.
DATABASE_URL=postgres://waze:waze@localhost:5433/network_waze

# Required for ingestion / extraction / NL search. Browsing seeded data works without it.
ANTHROPIC_API_KEY=

# Extraction + reasoning model.
WAZE_MODEL=claude-opus-5

# Embeddings. "hash" needs no key and is fine for local demos; "voyage" is the real one.
WAZE_EMBEDDING_PROVIDER=hash
VOYAGE_API_KEY=

# Required only when connecting Granola from a non-localhost deployment.
# The OAuth redirect URI is derived from the request origin, so this pins which
# origin is allowed to start a sign-in. Localhost is always permitted.
WAZE_APP_ORIGIN=

# Optional. On Windows, scripts/with-ca.mjs already loads the OS trust store
# (the same roots Avast / corporate proxies install). Set this only if Granola
# still fails TLS after a server restart.
WAZE_EXTRA_CA_CERTS=
